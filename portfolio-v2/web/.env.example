# Sanity — read-only identifiers for a public dataset, nothing secret here.
VITE_SANITY_PROJECT_ID=az7tzozl
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-09-06

# ─── Flyover basemap ───────────────────────────────────────────────────────
# Pick ONE of the three approaches below.

# 1. MapTiler (current choice: the Dataviz map).
#    Minimal by design, so it needs little stripping. Requires a free account;
#    the key ships in the client bundle, so restrict it by origin in the
#    MapTiler dashboard. Free tier is 100k tile requests/month.
#    MapTiler tiles cannot be self-hosted — see approach 3 for that.
# VITE_MAPTILER_KEY=
# VITE_MAPTILER_STYLE=dataviz-dark     # or dataviz / dataviz-light

# 2. Any explicit style URL. Wins over everything else.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# 3. Self-hosted tiles on Cloudflare R2, so the landing page depends on nobody.
#    Only works with an open tileset whose schema matches VITE_MAP_STYLE_URL.
#    See scripts/build-tiles.sh.
# VITE_MAP_PMTILES_URL=https://tiles.your-domain.com/southern-vancouver-island.pmtiles

# Strip every label and icon layer from whatever style is used. Default true.
# Set false to keep the style exactly as its author designed it — reasonable
# with Dataviz, which is already sparse.
# VITE_MAP_DECLUTTER=false

# Inject real extruded buildings into flat styles, and remove any faked 2.5D
# ones. Default true. Dataviz is a 2D style, so without this the tilted camera
# has almost nothing to bite on — Victoria is too flat for terrain alone.
# VITE_MAP_BUILDINGS_3D=false
